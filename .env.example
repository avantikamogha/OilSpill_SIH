# ==============================================================================
# SAR Oil Spill Detection Pipeline - Environment Configuration Template
# Instructions: Copy this file to '.env' and fill in your real credentials.
# NOTE: Never commit your actual '.env' file to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MongoDB Atlas Configuration
# ------------------------------------------------------------------------------
# Connection string format:
# mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI="mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority"
MONGO_DB_NAME="ocean_spill_intel"
MONGO_COLLECTION_NAME="detections"

# ------------------------------------------------------------------------------
# 2. Supabase Storage Configuration (For Binary Masks)
# ------------------------------------------------------------------------------
# Project URL & Public/Service Keys (Find under: Project Settings -> API)
SUPABASE_PROJECT_ID="your-project-ref-id"
SUPABASE_URL="https://your-project-ref-id.supabase.co"

# Public Anon Key (for client-side/dashboard reads)
SUPABASE_ANON_KEY="your-supabase-anon-key"

# Service Role Secret Key (Optional: for backend admin batch uploads bypassing RLS)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Public Storage Bucket Name & Base URL
SUPABASE_BUCKET_NAME="spill-masks"
MASK_STORAGE_BASE_URL="https://your-project-ref-id.supabase.co/storage/v1/object/public/spill-masks"

# ------------------------------------------------------------------------------
# 3. Model & Pipeline Runtime Settings
# ------------------------------------------------------------------------------
# Confidence threshold for binary mask classification (range: 0.0 to 1.0)
SPILL_CONFIDENCE_THRESHOLD=0.50

# Minimum pixel area to consider a detected contour an active spill
SPILL_MIN_PIXEL_AREA=100

# Device configuration: 'cuda', 'mps' (Apple Silicon), or 'cpu'
DEVICE="mps"


